{
  "manifest_version": 3,
  "name": "Hide Google AI Overview",
  "version": "1.0.0",
  "description": "Hides the Google Search 'AI Overview' block by default.",
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.google.co.uk/search*",
        "*://*.google.ca/search*",
        "*://*.google.com.au/search*",
        "*://*.google.de/search*",
        "*://*.google.fr/search*",
        "*://*.google.es/search*",
        "*://*.google.it/search*",
        "*://*.google.nl/search*",
        "*://*.google.co.in/search*",
        "*://*.google.co.jp/search*",
        "*://*.google.com.br/search*"
      ],
      "css": ["hide.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
